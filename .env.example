# Plant Doctor Backend Configuration
FASTAPI_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# MongoDB Atlas Connection
# Provide your genuine Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?appName=PlantDoctor
MONGODB_DB_NAME=plant_doctor

# Embedding Model Configuration (Local Real Vector Generation)
# Defaults to BAAI/bge-small-en-v1.5 (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional LLM Keys (Generates answer synthesis when provided; system works honestly without)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Admin Authentication for Ingestion Endpoints
ADMIN_API_KEY=dev-admin-secret-change-in-production
